// Database DDL: `npx prisma migrate deploy` (uses DIRECT_DATABASE_URL on Supabase).
// Prisma Client queries use DATABASE_URL (pooler OK). Migrations need direct Postgres (port 5432).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Zone {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  adminOrg          String?  @map("admin_org")
  escalationR1M     Int?     @map("escalation_r1_m")
  escalationR2M     Int?     @map("escalation_r2_m")
  escalationR3M     Int?     @map("escalation_r3_m")
  escalationDelayMs Int?     @map("escalation_delay_ms")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  healthWorkers HealthWorker[]
  patients      Patient[]
  volunteers    Volunteer[]
  hospitals     Hospital[]

  @@map("zones")
}

model HealthWorker {
  userId       String   @id @map("user_id") @db.Uuid
  name         String
  phone        String?
  phoneE164    String?  @default(dbgenerated("normalize_phone_for_match(phone)")) @map("phone_e164")
  zoneId       String?  @map("zone_id") @db.Uuid
  accessLevel  String   @default("health_worker") @map("access_level")
  organisation String?
  roleTitle    String?  @map("role_title")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  zone     Zone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  patients Patient[]

  @@map("health_workers")
}

model Patient {
  id                 String   @id @default(uuid()) @db.Uuid
  healthWorkerId     String   @map("health_worker_id") @db.Uuid
  zoneId             String?  @map("zone_id") @db.Uuid
  name               String
  age                Int?
  phonePrimary       String   @map("phone_primary")
  phoneE164          String   @default(dbgenerated("normalize_phone_for_match(phone_primary)")) @map("phone_e164")
  phoneSecondary     String?  @map("phone_secondary")
  village            String?
  landmark           String?
  /// @ignore — geography(Point,4326); use geoWrites / RPC for spatial ops
  location           Unsupported("geography(Point,4326)")
  weeksPregnant      Int?     @map("weeks_pregnant")
  dueDate            DateTime? @map("due_date") @db.Date
  prevPregnancies    Int?     @map("prev_pregnancies")
  prevBirths         Int?     @map("prev_births")
  prevCsection       Boolean  @default(false) @map("prev_csection")
  lastAncDate        DateTime? @map("last_anc_date") @db.Date
  bloodType          String?  @map("blood_type")
  language           String   @default("en")
  statusToken        String   @unique @default(uuid()) @map("status_token") @db.Uuid
  riskFlags          String[] @default([]) @map("risk_flags")
  medicationName     String?  @map("medication_name")
  emergencyContacts  Json     @default("[]") @map("emergency_contacts")
  patientStatus      String   @default("active") @map("patient_status")
  registrationVerified Boolean @default(true) @map("registration_verified")
  registrationSource   String   @default("health_worker") @map("registration_source")
  preferredHospitalId  String?  @map("preferred_hospital_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  healthWorker      HealthWorker @relation(fields: [healthWorkerId], references: [userId], onDelete: Restrict)
  zone              Zone?        @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  preferredHospital Hospital?    @relation("PatientPreferredHospital", fields: [preferredHospitalId], references: [id], onDelete: SetNull)
  alerts            Alert[]
  otpChallenges     PatientOtpChallenge[]

  @@map("patients")
}

model PatientOtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  patientId  String    @map("patient_id") @db.Uuid
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_otp_challenges")
}

model Volunteer {
  id             String    @id @default(uuid()) @db.Uuid
  zoneId         String?   @map("zone_id") @db.Uuid
  name           String
  phone          String
  phoneE164      String    @default(dbgenerated("normalize_phone_for_match(phone)")) @map("phone_e164")
  village        String?
  /// Typical availability, e.g. "weekdays 8am–6pm" (free text).
  availabilityHours String? @map("availability_hours")
  /// @ignore — geography(Point,4326)
  location       Unsupported("geography(Point,4326)")
  skills         String[]  @default([])
  vehicle        String    @default("none")
  isActive       Boolean   @default(true) @map("is_active")
  maxRadiusKm    Int       @default(5) @map("max_radius_km")
  language       String    @default("en")
  lastResponseAt DateTime? @map("last_response_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  zone                 Zone?                   @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  alertResponses       AlertResponse[]
  otpChallenges        VolunteerOtpChallenge[]
  alertsAsResponder    Alert[]                 @relation("AlertRespondingVolunteer")

  @@map("volunteers")
}

model Hospital {
  id               String   @id @default(uuid()) @db.Uuid
  zoneId           String?  @map("zone_id") @db.Uuid
  name             String
  type             String   @default("PHC")
  /// @ignore — geography(Point,4326)
  location         Unsupported("geography(Point,4326)")
  phoneMain        String?  @map("phone_main")
  phoneEmergency   String?  @map("phone_emergency")
  services         String[] @default([])
  /// 10 / 25 km pre-alert catchment from patient site; null = no cap (nearest in search radius).
  preAlertRadiusKm Int?     @map("pre_alert_radius_km")
  is24hr           Boolean  @default(false) @map("is_24hr")
  receiveAlerts    Boolean  @default(true) @map("receive_alerts")
  portalApiKeyHash String?  @map("portal_api_key_hash")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  zone              Zone?                @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  alertsNearest     Alert[]              @relation("NearestHospital")
  hospitalAlertAcks HospitalAlertAck[]
  preferredByPatients Patient[]          @relation("PatientPreferredHospital")

  @@map("hospitals")
}

model Alert {
  id                     String    @id @default(uuid()) @db.Uuid
  patientId              String    @map("patient_id") @db.Uuid
  status                 String    @default("active")
  priority               Int       @default(1)
  triggeredAt            DateTime  @default(now()) @map("triggered_at") @db.Timestamptz(6)
  resolvedAt             DateTime? @map("resolved_at") @db.Timestamptz(6)
  patientArrivedAt       DateTime? @map("patient_arrived_at") @db.Timestamptz(6)
  respondingVolunteerId  String?   @map("responding_volunteer_id") @db.Uuid
  volunteerConfirmedAt   DateTime? @map("volunteer_confirmed_at") @db.Timestamptz(6)
  nearestHospitalId      String?   @map("nearest_hospital_id") @db.Uuid
  waveNumber             Int       @default(1) @map("wave_number")
  incapacitationSuspected Boolean  @default(false) @map("incapacitation_suspected")
  triggerMethod          String    @default("pwa") @map("trigger_method")
  patientInteractionAt   DateTime? @map("patient_interaction_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient              Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  respondingVolunteer  Volunteer?      @relation("AlertRespondingVolunteer", fields: [respondingVolunteerId], references: [id], onDelete: SetNull)
  nearestHospital      Hospital?       @relation("NearestHospital", fields: [nearestHospitalId], references: [id], onDelete: SetNull)
  alertResponses       AlertResponse[]
  hospitalAlertAcks    HospitalAlertAck[]
  alertEvents          AlertEvent[]
  outboundMessages     OutboundMessage[]

  @@map("alerts")
}

model AlertEvent {
  id        String   @id @default(uuid()) @db.Uuid
  alertId   String   @map("alert_id") @db.Uuid
  eventType String   @map("event_type")
  actorType String?  @map("actor_type")
  actorId   String?  @map("actor_id")
  channel   String?
  metadata  Json     @default("{}")
  requestId String?  @map("request_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt], map: "alert_events_alert_created_idx")
  @@map("alert_events")
}

model OutboundMessage {
  id                String    @id @default(uuid()) @db.Uuid
  alertId           String?   @map("alert_id") @db.Uuid
  recipient         String
  provider          String
  providerMessageId String?   @map("provider_message_id")
  channel           String    @default("sms")
  status            String    @default("queued")
  error             String?
  metadata          Json      @default("{}")
  requestId         String?   @map("request_id")
  statusUpdatedAt   DateTime? @map("status_updated_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  alert Alert? @relation(fields: [alertId], references: [id], onDelete: SetNull)

  @@index([alertId, createdAt], map: "outbound_messages_alert_created_idx")
  @@index([providerMessageId], map: "outbound_messages_provider_message_idx")
  @@map("outbound_messages")
}

model AlertResponse {
  id          String    @id @default(uuid()) @db.Uuid
  alertId     String    @map("alert_id") @db.Uuid
  volunteerId String    @map("volunteer_id") @db.Uuid
  response    String?
  sentAt      DateTime  @default(now()) @map("sent_at") @db.Timestamptz(6)
  respondedAt DateTime? @map("responded_at") @db.Timestamptz(6)
  waveNumber  Int       @default(1) @map("wave_number")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  alert     Alert     @relation(fields: [alertId], references: [id], onDelete: Cascade)
  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([alertId, volunteerId, waveNumber], map: "alert_responses_alert_volunteer_wave_unique")
  @@map("alert_responses")
}

model HospitalAlertAck {
  id          String   @id @default(uuid()) @db.Uuid
  alertId     String   @map("alert_id") @db.Uuid
  hospitalId  String   @map("hospital_id") @db.Uuid
  ackType     String   @map("ack_type")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  alert    Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@map("hospital_alert_acks")
}

model VolunteerOtpChallenge {
  id           String    @id @default(uuid()) @db.Uuid
  volunteerId  String    @map("volunteer_id") @db.Uuid
  codeHash     String    @map("code_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@map("volunteer_otp_challenges")
}

model DelayedJob {
  id        String    @id @default(uuid()) @db.Uuid
  dedupeKey String    @unique @map("dedupe_key")
  jobType   String    @map("job_type")
  payload   Json
  runAfter  DateTime  @map("run_after") @db.Timestamptz(6)
  lockedAt  DateTime? @map("locked_at") @db.Timestamptz(6)
  attempts  Int       @default(0)
  lastError String?   @map("last_error")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("delayed_jobs")
}

model AuthOtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phoneE164  String    @map("phone_e164")
  role       String
  profileId  String    @map("profile_id") @db.Uuid
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phoneE164, createdAt], map: "auth_otp_challenges_phone_created_idx")
  @@map("auth_otp_challenges")
}
