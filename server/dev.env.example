# Used by: npm run env:init  (and predev before npm run dev if .env is missing)
# Replace SUPABASE_* with your project (Settings → API) when you are ready.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace-with-service-role-key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace-with-anon-key
# Postgres connection for Prisma (Supabase → Project Settings → Database → URI). Prefer pooler with ?pgbouncer=true&connection_limit=1 for serverless.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
TWILIO_MOCK=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
SMS_SOS_KEYWORDS=HELP,SOS,EMERGENCY
INCAPACITATION_DELAY_MS=60000
ESCALATION_DELAY_MS=300000
SERVER_PUBLIC_URL=http://localhost:3000
COORDINATOR_PHONE=
AT_API_KEY=
AT_USERNAME=
PORT=3000
CLIENT_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# Min 16 chars each — used for PWA SOS links and volunteer/hospital portal JWTs
SOS_SIGNING_SECRET=dev-sos-signing-secret-change-me-16chars
PORTAL_JWT_SECRET=dev-portal-jwt-secret-change-me-16ch
# Optional: allow PWA SOS with phone only (insecure; local demos)
# ALLOW_LEGACY_PWA_SOS_PHONE_ONLY=true
# Optional: protect GET /api/health/db (header X-Health-Db-Token)
# HEALTH_DB_TOKEN=
NODE_ENV=development
COORDINATOR_VOICE_ON_ESCALATION=false
# TRUST_PROXY_HOPS=1
