# Used by: npm run env:init  (and predev before npm run dev if .env is missing)
# Replace SUPABASE_* with your project (Settings → API) when you are ready.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace-with-service-role-key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace-with-anon-key
# Prisma Client (API): Supabase pooler is fine (port 6543).
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Prisma Migrate / db push: MUST be direct Postgres (port 5432). Supabase -> Database -> Connection string -> URI (Direct).
# Local Postgres without a pooler: set this equal to DATABASE_URL.
# Docker / API-only: omit if you only set DATABASE_URL — the server defaults DIRECT_DATABASE_URL to DATABASE_URL (run migrate from dev/CI with direct URL).
DIRECT_DATABASE_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres
TWILIO_MOCK=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
SMS_SOS_KEYWORDS=HELP,SOS,EMERGENCY
INCAPACITATION_DELAY_MS=60000
ESCALATION_DELAY_MS=300000
SERVER_PUBLIC_URL=http://localhost:3000
COORDINATOR_PHONE=
AT_API_KEY=
AT_USERNAME=
PORT=3000
CLIENT_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# Min 16 chars each — used for PWA SOS links and volunteer/hospital portal JWTs
SOS_SIGNING_SECRET=dev-sos-signing-secret-change-me-16chars
PORTAL_JWT_SECRET=dev-portal-jwt-secret-change-me-16ch
AUTH_SESSION_JWT_SECRET=
HEALTH_WORKER_SIGNUP_CODE=change-me-worker-signup-code
ADMIN_SIGNUP_CODE=change-me-admin-signup-code
# Optional: allow PWA SOS with phone only (insecure; local demos)
# ALLOW_LEGACY_PWA_SOS_PHONE_ONLY=true
# Patient self-register: fallback health_worker user_id when a zone has no field workers
# SELF_REG_DEFAULT_HEALTH_WORKER_ID=
# Optional: fallback coordinates for patient / volunteer signup when browser location is unavailable
# SELF_REG_FALLBACK_LAT=18.5204
# SELF_REG_FALLBACK_LNG=73.8567
# SMS family contacts the /status link when a patient is registered (HW or self-service)
# SEND_FAMILY_STATUS_SMS_ON_REGISTER=false
# Optional: protect GET /api/health/db (header X-Health-Db-Token)
# HEALTH_DB_TOKEN=
NODE_ENV=development
COORDINATOR_VOICE_ON_ESCALATION=false
# TRUST_PROXY_HOPS=1
