{
  "name": "server",
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "env:init": "node scripts/init-dev-env.cjs",
    "predev": "node scripts/init-dev-env.cjs",
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/index.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "build": "prisma generate && tsc && tsc-alias -p tsconfig.json",
    "start": "node scripts/start.cjs",
    "start:strict": "node scripts/start.cjs --strict",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.101.1",
    "africastalking": "^0.7.9",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.19.3",
    "twilio": "^5.13.1",
    "zod": "^4.3.6"
  },
  "overrides": {
    "axios": "^1.15.0",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.2",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "type": "commonjs"
}
