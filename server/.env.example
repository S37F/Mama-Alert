# Quick start: see dev.env.example and run `npm run env:init` (runs automatically before `npm run dev` if .env is missing).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Postgres URI for Prisma (Supabase → Database settings). Pooler: add ?pgbouncer=true&connection_limit=1
DATABASE_URL=
# Set TWILIO_MOCK=true to run locally without real Twilio (SMS logged only; webhook signature check skipped).
TWILIO_MOCK=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
# Comma-separated keywords patients can text to trigger SOS (case-insensitive).
SMS_SOS_KEYWORDS=HELP,SOS,EMERGENCY
# After PWA/SMS SOS, if no volunteer confirms in this many ms, notify family + widen to 10 km volunteers.
INCAPACITATION_DELAY_MS=60000
# Time between escalation waves (default 5 minutes). Use 30000 for quick manual tests.
ESCALATION_DELAY_MS=300000
# Public URL Twilio calls for SMS status (often your API host). Defaults to CLIENT_URL if unset.
SERVER_PUBLIC_URL=
# Optional: receives escalation SMS when volunteers do not respond
COORDINATOR_PHONE=
AT_API_KEY=
AT_USERNAME=
# Auth: health workers use Supabase Auth (Bearer access_token). No custom JWT_SECRET.
PORT=3000
SOS_SIGNING_SECRET=
PORTAL_JWT_SECRET=
CLIENT_URL=
# PWA origin for /status/{token} links in SMS (family, etc.). Defaults to CLIENT_URL if unset.
PUBLIC_APP_URL=
NODE_ENV=development
# Number of reverse proxies in front of the app (Railway/Vercel edge). Default 1.
# TRUST_PROXY_HOPS=1
# When true, coordinator also receives a voice call at wave-3 (final escalation). Requires real Twilio.
COORDINATOR_VOICE_ON_ESCALATION=false
