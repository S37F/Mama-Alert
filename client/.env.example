# Quick start: dev.env.example + `npm run env:init` (or predev) if .env is missing.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
VITE_HELP_PHONE=
# From POST /api/register/patient response field `sos_token` (for /demo real SOS button).
VITE_DEMO_SOS_TOKEN=
# Optional: UUID `status_token` for /status/demo-status-token-abc123.
VITE_DEMO_STATUS_TOKEN=
