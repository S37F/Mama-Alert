# Quick start: dev.env.example + `npm run env:init` (or predev) if .env is missing.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
# E.164 phone registered in Supabase seed for DemoFlow “Trigger real SOS”
VITE_DEMO_PHONE=
# "true" = expose /hospital web inbox for demos. Default off; facilities resolve alerts via SMS (reply ARRIVED).
VITE_ENABLE_HOSPITAL_PORTAL=
